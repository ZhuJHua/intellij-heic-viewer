<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<!-- <description> and <change-notes> are generated by Gradle (patchPluginXml): the description from the
     "Plugin description" section of README.md, the change notes from CHANGELOG.md. <version> and <idea-version>
     come from gradle.properties. -->
<idea-plugin>
  <id>cn.yooss.heic-viewer</id>
  <name>HEIC Viewer</name>
  <vendor url="https://yooss.cn" email="livejinghua@gmail.com">ZhuJHua</vendor>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.platform.images</depends>
  <!-- No OS dependency: everything below is loaded on macOS, Windows and Linux. The decoder is the operating system's
       own (macOS ImageIO.framework, Windows WIC with the HEIF/HEVC extensions, Linux libheif), chosen and probed at
       runtime by cn.yooss.heic.backend.HeifBackends; without one, HEIC files show "Image not loaded" and the user is
       told what to install. (An OS dependency, even an optional one, makes IntelliJ 2024.1-2025.1 refuse to load the
       plugin on the other systems.) -->

  <resource-bundle>messages.HeicBundle</resource-bundle>

  <extensions defaultExtensionNs="com.intellij">
    <!-- Adds the extensions to the built-in "Image" file type (no implementationClass: merged into the existing
         type, like the bundled WebP support). -->
    <fileType name="Image" extensions="heic;heif;hif;heics"/>

    <!-- Linux only (os="linux": not registered elsewhere): a libheif.so.1 outside the dynamic linker's search path. -->
    <advancedSetting id="heic.viewer.libheif.path" default="" os="linux" bundle="messages.HeicBundle"
                     groupKey="group.advanced.settings.heic"/>

    <!-- Registers the javax.imageio reader in the command-line diff and merge starters (`studio diff a.heic b.heic`
         while the IDE is not running), which never fire appFrameCreated: asked before an image viewer is created for
         an Image file. accept() always returns false, so it never provides an editor. -->
    <fileEditorProvider implementation="cn.yooss.heic.HeicReaderRegistrar" fileType="Image"/>

    <!-- When the system decoder is unavailable (e.g. the Windows HEIF/HEVC extensions or the Linux libheif packages
         are missing), the user is told where a HEIC image fails to load, with the remedy (package cn.yooss.heic.ui):
         a banner above the HEIC image editor, and for the diff viewer one balloon per session
         (also right after installing the plugin); "Check Again" and the results are balloons too. Never probes the
         decoder on the EDT. -->
    <editorNotificationProvider implementation="cn.yooss.heic.ui.HeicDecoderNotificationProvider"/>
    <!-- Images are decoded at full size like PNG and JPEG; only when that would likely exhaust the IDE's Java heap is an
         image decoded smaller (cn.yooss.heic.HeapValve), and this banner above it says so and how to see it at full
         size. Nothing is collected unless an image was decoded smaller in this session. -->
    <editorNotificationProvider implementation="cn.yooss.heic.ui.HeicDownscaleNotificationProvider"/>
    <diff.DiffExtension implementation="cn.yooss.heic.ui.HeicDiffExtension"/>
    <notificationGroup id="HEIC Viewer" displayType="BALLOON" bundle="messages.HeicBundle"
                       key="notification.group.heic"/>
  </extensions>

  <applicationListeners>
    <!-- Registration of the javax.imageio reader. Deliberately not ApplicationLoadListener (internal API and not
         dynamic) and not 262's imageReaderWriterSpi extension point (unknown before 262, which blocks dynamic
         unload). -->
    <listener class="cn.yooss.heic.HeicAppLifecycleListener" topic="com.intellij.ide.AppLifecycleListener"/>
    <listener class="cn.yooss.heic.HeicDynamicPluginListener" topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    <!-- Checks the decoder again when the IDE is activated after the user clicked a remedy action (a Store page, a
         copied install command); a volatile read otherwise. -->
    <listener class="cn.yooss.heic.ui.HeicActivationListener"
              topic="com.intellij.openapi.application.ApplicationActivationListener"/>
  </applicationListeners>

  <projectListeners>
    <!-- The platform collects editor banners by itself for text editors only: asks for the banner of an opened HEIC
         image editor while the decoder is missing (nothing otherwise). -->
    <listener class="cn.yooss.heic.ui.HeicFileOpenedListener"
              topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
  </projectListeners>
</idea-plugin>
