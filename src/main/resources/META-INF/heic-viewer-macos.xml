<!-- Loaded only on macOS (optional dependency on com.intellij.modules.os.mac in plugin.xml). -->
<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <!-- Adds the extensions to the built-in "Image" file type (no implementationClass: merged into the existing
         type, like the bundled WebP support). -->
    <fileType name="Image" extensions="heic;heif;hif;heics"/>

    <advancedSetting id="heic.viewer.max.megapixels" default="64" bundle="messages.HeicBundle"
                     groupKey="group.advanced.settings.heic"/>
    <advancedSetting id="heic.viewer.project.view.thumbnails" default="true" bundle="messages.HeicBundle"
                     groupKey="group.advanced.settings.heic"/>

    <!-- Thumbnail icons for HEIC files. order="first": it only answers for local HEIC files whose thumbnail is
         ready (null otherwise), and must not be preempted by a generic provider. Decoding happens on the plugin's
         own bounded executor, never in getIcon. -->
    <fileIconProvider implementation="cn.yooss.heic.thumbnail.HeicThumbnailIconProvider" order="first"/>

    <!-- Registers the javax.imageio reader in the command-line diff and merge starters (`studio diff a.heic b.heic`
         while the IDE is not running), which never fire appFrameCreated: asked before an image viewer is created for
         an Image file. accept() always returns false, so it never provides an editor. -->
    <fileEditorProvider implementation="cn.yooss.heic.HeicReaderRegistrar" fileType="Image"/>
  </extensions>

  <applicationListeners>
    <!-- Registration of the javax.imageio reader. Deliberately not ApplicationLoadListener (internal API and not
         dynamic) and not 262's imageReaderWriterSpi extension point (unknown on 261, which blocks dynamic unload). -->
    <listener class="cn.yooss.heic.HeicAppLifecycleListener" topic="com.intellij.ide.AppLifecycleListener"/>
    <listener class="cn.yooss.heic.HeicDynamicPluginListener" topic="com.intellij.ide.plugins.DynamicPluginListener"/>
    <!-- Thumbnail icons: apply a toggled setting to icons already shown; refresh icons of HEIC files changed on disk. -->
    <listener class="cn.yooss.heic.thumbnail.HeicThumbnailSettingsListener"
              topic="com.intellij.openapi.options.advanced.AdvancedSettingsChangeListener"/>
    <listener class="cn.yooss.heic.thumbnail.HeicThumbnailFileListener"
              topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
  </applicationListeners>
</idea-plugin>
